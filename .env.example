# Optional TileJSON endpoint for Mapshow's dedicated schema-v3 simulation-road vector tiles.
# Generate XYZ .pbf + tilejson.json with:
#   cargo run --release --manifest-path road-schema/Cargo.toml -- build-xyz ...
# Serve that output over HTTP and point this variable at tilejson.json.
# When omitted, simulation road surfaces and road physics remain disabled rather than falling back to
# OpenFreeMap's cartographic transportation layer.
# VITE_GAME_ROADS_TILEJSON=http://localhost:8080/game-roads/tilejson.json

# The Rust generator can also emit PMTiles v3, but direct PMTiles browser loading is not wired yet.
# Use XYZ/TileJSON for the current browser runtime.

# Optional MapLibre line overlay for inspecting the raw game_road MVT centerlines underneath the
# generated Three.js carriageway surfaces.
# VITE_GAME_ROADS_DEBUG=false
