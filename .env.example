# Optional TileJSON endpoint for Mapshow's dedicated simulation-road vector tiles.
# Serve road-schema/data/game-roads.mbtiles through a compatible vector-tile server and point this at its TileJSON.
# VITE_GAME_ROADS_TILEJSON=http://localhost:8080/data/game-roads.json

# Optional visual validation overlay for the game_road layer. This is not the final driveable road mesh.
# VITE_GAME_ROADS_DEBUG=false
