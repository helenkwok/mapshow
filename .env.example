# Optional TileJSON endpoint for Mapshow's dedicated simulation-road vector tiles.
# Generate schema-v2 tiles with road-schema/, serve the MBTiles through a compatible vector-tile server,
# and point this at its TileJSON. When omitted, driveable road surfaces remain disabled rather than
# falling back to OpenFreeMap's cartographic road layer.
# VITE_GAME_ROADS_TILEJSON=http://localhost:8080/data/game-roads.json

# Optional MapLibre line overlay for inspecting the raw game_road MVT centerlines underneath the
# generated Three.js carriageway surfaces.
# VITE_GAME_ROADS_DEBUG=false
