{
  "schema": "mapshow.game-road",
  "version": 3,
  "layer": "game_road",
  "minzoom": 12,
  "maxzoom": 16,
  "geometry": "LineString",
  "segmentation": "OpenStreetMap ways split at shared OSM nodes before vector tiling",
  "properties": {
    "schema_version": { "type": "integer", "required": true },
    "segment_id": { "type": "integer", "required": true, "description": "Planetiler-unique intersection-to-intersection road segment ID." },
    "osm_id": { "type": "integer", "required": true, "description": "Stable parent OpenStreetMap way ID." },
    "highway": { "type": "string", "required": true, "description": "Raw OSM highway class." },
    "road_class": { "type": "string", "required": true, "description": "Link suffix removed for class-level logic." },
    "is_link": { "type": "boolean", "required": true },
    "name": { "type": "string" },
    "ref": { "type": "string" },
    "service": { "type": "string" },
    "access": { "type": "string" },
    "vehicle": { "type": "string" },
    "motor_vehicle": { "type": "string" },
    "lanes_raw": { "type": "string" },
    "lanes": { "type": "integer" },
    "lanes_forward_raw": { "type": "string" },
    "lanes_forward": { "type": "integer" },
    "lanes_backward_raw": { "type": "string" },
    "lanes_backward": { "type": "integer" },
    "turn_lanes_raw": { "type": "string", "description": "Raw OSM turn:lanes value; normally used on one-way carriageways." },
    "turn_lanes_forward_raw": { "type": "string" },
    "turn_lanes_backward_raw": { "type": "string" },
    "change_lanes_raw": { "type": "string", "description": "Raw OSM change:lanes value for later lane-change policy." },
    "change_lanes_forward_raw": { "type": "string" },
    "change_lanes_backward_raw": { "type": "string" },
    "turn_restrictions": { "type": "string", "description": "JSON array of OSM restriction relations applying when this parent way is the from-way. Simple via-node restrictions can be enforced directly; via-way and conditional restrictions are preserved for later policy." },
    "maxspeed_raw": { "type": "string" },
    "speed_kmh": { "type": "number", "description": "Parsed tagged maxspeed only; no legal-speed inference." },
    "maxspeed_forward_raw": { "type": "string" },
    "speed_forward_kmh": { "type": "number" },
    "maxspeed_backward_raw": { "type": "string" },
    "speed_backward_kmh": { "type": "number" },
    "width_raw": { "type": "string" },
    "width_m": { "type": "number", "required": true, "description": "Tagged or estimated carriageway width." },
    "width_source": { "type": "string", "enum": ["tag", "lanes", "class_default"], "required": true },
    "surface": { "type": "string" },
    "surface_class": { "type": "string", "enum": ["paved", "unpaved", "unknown"], "required": true },
    "smoothness": { "type": "string" },
    "tracktype": { "type": "string" },
    "oneway_raw": { "type": "string" },
    "oneway": { "type": "integer", "enum": [-1, 0, 1], "required": true },
    "junction": { "type": "string" },
    "bridge": { "type": "boolean", "required": true },
    "tunnel": { "type": "boolean", "required": true },
    "layer": { "type": "integer", "required": true },
    "z_order": { "type": "integer", "required": true, "description": "Convenience ordering hint; bridge/tunnel/layer remain authoritative inputs." },
    "sidewalk": { "type": "string" },
    "cycleway": { "type": "string" },
    "lit": { "type": "string" },
    "incline": { "type": "string" },
    "priority": { "type": "integer", "required": true },
    "first_node": { "type": "integer", "required": true, "description": "First OSM node ID of this intersection-split segment." },
    "last_node": { "type": "integer", "required": true, "description": "Last OSM node ID of this intersection-split segment." },
    "node_count": { "type": "integer", "required": true, "description": "Number of OSM source vertices retained in this segment before tile clipping." }
  }
}
